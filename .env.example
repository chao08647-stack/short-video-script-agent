# DeepSeek Flash: fill the key in your private .env, never commit it.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Planner action protocol: native (default) or json (explicit JSON actions).
# DeepSeek uses native tool calls; this project's json_schema protocol is not supported.
# Both modes call the real model. Invalid responses never trigger a protocol switch or Mock fallback.
LLM_ACTION_PROTOCOL=native
# This adapter does not retain reasoning_content for thinking-mode tool-call replay.
LLM_THINKING=disabled
# Maximum output tokens per model request, not the total context length.
LLM_MAX_TOKENS=4096
# Application input + reserved output budget: 16 * 1024 tokens, not a server setting.
# Uses the official 1017 tokenizer/encoder, payload comparison, 10% + 128 safety margin,
# then checks response usage. This is an estimate, not an exact server prompt count.
LLM_CONTEXT_WINDOW=16384
SCRIPT_AGENT_RUNS_DIR=.runs

# Optional local Qwen service: replace the active values above with these values.
# The service owner configures its actual server context (32K in the recorded baseline).
# LLM_BASE_URL=http://127.0.0.1:8012/v1
# LLM_MODEL=qwen25-14b-pbn-answer
# LLM_API_KEY=
# LLM_ACTION_PROTOCOL=json
# LLM_THINKING=default
# LLM_MAX_TOKENS=2048
# LLM_CONTEXT_WINDOW=0
# json requires JSON Schema structured output with anyOf and const.
# 0 disables the DeepSeek-specific local token budget; it does not change the server.
