  "brief": {
    "topic": "小剪 App 的字幕生成与手动修改教程",
    "audience": "第一次制作视频字幕的创作者",
    "platform": "B站",
    "target_seconds": 45.0,
    "style": "清楚克制，按步骤解释，字幕简短易读"
