# The local endpoint below was successfully preflight-tested; change for other services.
LLM_BASE_URL=http://127.0.0.1:8012/v1
LLM_MODEL=qwen25-14b-pbn-answer
# Leave empty if the endpoint does not require authentication.
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Planner action protocol: native (default) or json (explicit JSON actions).
# json requires JSON Schema structured output with anyOf and const.
# Both modes call the real model. Invalid responses never trigger a protocol switch or Mock fallback.
# This example explicitly selects json for the supplied local model.
LLM_ACTION_PROTOCOL=json
# Output token budget; the local service currently has a 32768-token context.
LLM_MAX_TOKENS=2048
SCRIPT_AGENT_RUNS_DIR=.runs
